// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id @default(uuid())
  loginId          String           @unique @map("login_id")
  displayName      String           @map("display_name")
  familyName       String?          @map("family_name")
  givenName        String?          @map("given_name")
  email            String?
  role             Role             @default(USER)
  passwordHash     String           @map("password_hash")
  isActive         Boolean          @default(true) @map("is_active")
  membershipStatus MembershipStatus @default(ACTIVE) @map("membership_status")
  withdrawnAt      DateTime?        @map("withdrawn_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  sessions                   Session[]
  dailyLogs                  DailyLog[]
  competitionGoals           CompetitionGoal[]
  storyVersions              StoryVersion[]
  guardianConsent            GuardianConsent?
  registrationInvitesCreated RegistrationInvite[] @relation("RegistrationInviteCreator")
  registrationInviteUsed     RegistrationInvite?  @relation("RegistrationInviteRegistrant")
  adminActions               AdminAuditEvent[]     @relation("AdminAuditActor")
  auditTargets               AdminAuditEvent[]     @relation("AdminAuditTarget")

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  WITHDRAWN
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("sessions")
}

model DailyLog {
  id           String            @id @default(uuid())
  userId       String            @map("user_id")
  logDate      DateTime          @map("log_date") @db.Date
  score        Int // 1-10
  activityType DailyActivityType @default(REST) @map("activity_type")
  // Kept during the compatibility rollout for older app versions.
  practiced    Boolean           @default(false)
  revision     Int               @default(1)
  goodText     String?           @map("good_text") @db.Text
  improveText  String?           @map("improve_text") @db.Text
  tomorrowText String?           @map("tomorrow_text") @db.Text
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, logDate])
  @@index([userId, logDate(sort: Desc)])
  @@map("daily_logs")
}

enum DailyActivityType {
  PRACTICE
  COMPETITION
  REST
}

enum CompetitionGoalType {
  NEXT_MEET
  ANNUAL
  MILESTONE
}

model CompetitionGoal {
  id         String              @id @default(uuid())
  userId     String              @map("user_id")
  type       CompetitionGoalType @map("goal_type")
  title      String
  details    String?             @db.Text
  targetDate DateTime?           @map("target_date") @db.Date
  isActive   Boolean             @default(true) @map("is_active")
  archivedAt DateTime?           @map("archived_at")
  revision   Int                 @default(1)
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive, updatedAt(sort: Desc)])
  @@index([userId, type, isActive])
  @@map("competition_goals")
}

model StoryVersion {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  version   Int
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers StoryAnswer[]

  @@unique([userId, version])
  @@index([userId, version(sort: Desc)])
  @@map("story_versions")
}

model StoryAnswer {
  id             String @id @default(uuid())
  storyVersionId String @map("story_version_id")
  questionNo     Int    @map("question_no") // 1-15
  answerText     String @map("answer_text") @db.Text

  storyVersion StoryVersion @relation(fields: [storyVersionId], references: [id], onDelete: Cascade)

  @@unique([storyVersionId, questionNo])
  @@map("story_answers")
}

model RateLimitEvent {
  id        String   @id @default(uuid())
  keyHash   String   @map("key_hash")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([keyHash, createdAt])
  @@index([createdAt])
  @@map("rate_limit_events")
}

model RegistrationInvite {
  id           String    @id @default(uuid())
  tokenHash    String    @unique @map("token_hash")
  athleteName  String    @map("athlete_name")
  createdById  String    @map("created_by_id")
  usedByUserId String?   @unique @map("used_by_user_id")
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  createdBy User  @relation("RegistrationInviteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  usedBy    User? @relation("RegistrationInviteRegistrant", fields: [usedByUserId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("registration_invites")
}

model GuardianConsent {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  guardianName         String   @map("guardian_name")
  guardianRelationship String   @map("guardian_relationship")
  noticeVersion        String   @map("notice_version")
  acceptedAt           DateTime @default(now()) @map("accepted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([acceptedAt(sort: Desc)])
  @@map("guardian_consents")
}

model AdminAuditEvent {
  id           String   @id @default(uuid())
  actorId      String   @map("actor_id")
  targetUserId String?  @map("target_user_id")
  action       String
  createdAt    DateTime @default(now()) @map("created_at")

  actor      User  @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUser User? @relation("AdminAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetUserId, createdAt(sort: Desc)])
  @@map("admin_audit_events")
}
