{
  "name": "swim-story",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "test:db": "node --import tsx --test src/integration/*.test.ts",
    "test:migrations": "node --import tsx scripts/test-migrations.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "db:init": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:verify": "node --import tsx scripts/verify-database.ts",
    "admin:create": "node --import tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcrypt": "^6.0.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "prisma": "7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
